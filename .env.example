DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# SQLite en local ; décommenter la ligne suivante pour cibler PostgreSQL.
# Format : postgresql://<user>:<password>@<host>:<port>/<database>
# Les caractères spéciaux du mot de passe doivent être percent-encodés (@ -> %40).
# DATABASE_URL=postgresql://equipit:equipit@localhost:5432/equipit
